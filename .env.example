# Copy to .env next to docker-compose.yml. Never commit the real .env.
DATABRIDGE_IMAGE=hkccr.ccs.tencentyun.com/buall/databridge:latest
DATABRIDGE_BIND_ADDRESS=0.0.0.0
DATABRIDGE_PORT=8081
DATABRIDGE_AUTH_USER=admin

# Required: generate a password with `openssl rand -hex 24`.
DATABRIDGE_AUTH_PASSWORD=
# Required: generate a separate signing secret with `openssl rand -base64 32`.
# Keep this value across container restarts.
DATABRIDGE_SESSION_SECRET=

DATABRIDGE_PG_JOBS=4
# Set true only when the browser accesses DataBridge through HTTPS.
DATABRIDGE_COOKIE_SECURE=false
# Example: https://databridge.example.com (used for OneDrive OAuth callbacks).
DATABRIDGE_PUBLIC_URL=
# Leave empty for the bundled frontend; set an allowed origin for a separate frontend.
DATABRIDGE_CORS_ORIGIN=
