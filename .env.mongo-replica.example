# Copy this file to mongo-replica.env beside docker-compose.mongo-replica.yml.
# Do not commit the resulting file.
MONGO_ROOT_USERNAME=databridge_backup
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
# Use the server's private IP or a DNS name resolvable by every replica member
# and by DataBridge. Do not use 0.0.0.0.
MONGO_ADVERTISED_HOST=192.168.2.113
# Bind only to the same private interface. Firewall rules must allow TCP 27017-27019
# only from DataBridge and the MongoDB server itself.
MONGO_BIND_ADDRESS=192.168.2.113
